{
  "name": "rocketseat-fastify",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "env:setup": "copy .env.example .env",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "local:setup": "npm run env:setup && npm run infra:up",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
