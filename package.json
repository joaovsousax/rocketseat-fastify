{
  "name": "rocketseat-fastify",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "env:setup": "copy .env.example .env",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "local:setup": "npm run env:setup && npm run infra:up && npm run migrations:run",
    "migrations:generate": "drizzle-kit generate",
    "migrations:run": "tsx src/db/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@scalar/fastify-api-reference": "^1.84.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "nanoid": "^6.0.2",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
